<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_right"
            android:rotation="180"
            app:tint="@color/text_primary"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Share Case"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPost"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:text="Post"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingHorizontal="8dp" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Case Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivCaseThumb"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/teeth_placeholder"
                    app:shapeAppearanceOverlay="@style/RoundedImage" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvCaseTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RCT wrt 46"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvCaseDiagnosis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Irreversible pulpitis"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Add a caption (optional)"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:gravity="top"
                android:hint="Managed with bioceramic sealer.\nPost-op doing well."
                android:inputType="textMultiLine"
                android:minHeight="120dp"
                android:padding="16dp"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Who can see this?"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <!-- Visibility Options -->
            <RadioGroup
                android:id="@+id/rgVisibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <RadioButton
                    android:id="@+id/rbPublic"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Public (Everyone)"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:button="@null"
                    android:drawableEnd="@android:drawable/btn_radio"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/rbConnections"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Connections"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:button="@null"
                    android:drawableEnd="@android:drawable/btn_radio" />

                <RadioButton
                    android:id="@+id/rbOnlyMe"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Only Me"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="16dp"
                    android:button="@null"
                    android:drawableEnd="@android:drawable/btn_radio" />
            </RadioGroup>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
